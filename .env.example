# Copy this file to .env and fill it in. .env is git-ignored - never commit it.

# --- Telegram -------------------------------------------------------------
# Create a bot with @BotFather in Telegram and paste its token here.
TELEGRAM_BOT_TOKEN=

# --- Postgres -------------------------------------------------------------
# Only reachable inside the Docker network, but change it anyway.
# Letters and digits only (it is placed inside a connection URL).
POSTGRES_PASSWORD=changeme

# --- Optional AI briefing ---------------------------------------------------
# Leave all three empty and newshub works with keyword scoring only.
# Any OpenAI-compatible endpoint works. Free options:
#   Gemini : LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#            LLM_MODEL=gemini-2.0-flash          (key: https://aistudio.google.com/apikey)
#   Groq   : LLM_BASE_URL=https://api.groq.com/openai/v1
#            LLM_MODEL=llama-3.3-70b-versatile   (key: https://console.groq.com/keys)
#   Ollama : LLM_BASE_URL=http://host.docker.internal:11434/v1
#            LLM_MODEL=llama3.2                  (no key needed)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
